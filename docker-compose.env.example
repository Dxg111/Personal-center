# 复制为 .env（与 docker-compose.yml 同目录）
# 以下 MySQL 变量不要使用默认弱密码

MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=personal_center
MYSQL_USER=pcenter
MYSQL_PASSWORD=change-me-app-password

# 站点对外地址，用于后端 CORS
PUBLIC_ORIGIN=http://localhost:8080

# 本地验证使用 8080；生产服务器改为 80
FRONTEND_PORT=8080

# 前端构建使用的 npm 源；国内网络可用 https://registry.npmmirror.com
NPM_REGISTRY=https://registry.npmjs.org/

# 后端构建使用的 pip 源；大陆服务器必须换成国内镜像，默认清华源
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
