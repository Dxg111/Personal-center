# 复制为 backend/.env.production
# 该文件通过 docker-compose 的 env_file 注入，不会被复制进镜像

SECRET_KEY=change-me-use-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-use-a-strong-password

UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=5242880

SQL_ECHO=false
CORS_ORIGINS=http://localhost:8080

# DATABASE_URL、UPLOAD_DIR、SQL_ECHO、CORS_ORIGINS 会由 docker-compose 覆盖，
# 因此这里不需要写死数据库地址。
